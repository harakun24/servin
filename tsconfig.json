{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "typeRoots": ["./"],
    "types": ["./servin.d.ts"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
  },
  "include": ["**/*.js", "servin.d.ts"]
}
